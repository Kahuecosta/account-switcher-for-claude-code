{
  "name": "claude-code-multi-account",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.1.0",
  "publisher": "kahuecosta",
  "author": {
    "name": "Kahuê Costa"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1F2328",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kahuecosta/account-switcher-for-claude-code.git"
  },
  "bugs": {
    "url": "https://github.com/Kahuecosta/account-switcher-for-claude-code/issues"
  },
  "homepage": "https://github.com/Kahuecosta/account-switcher-for-claude-code#readme",
  "qna": "marketplace",
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "multiple accounts",
    "multi-account",
    "switch account",
    "account switcher",
    "profile",
    "CLAUDE_CONFIG_DIR",
    "rate limit",
    "usage limit",
    "quota"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "AI"
  ],
  "pricing": "Free",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./src/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%untrusted.description%",
      "restrictedConfigurations": [
        "claudeAccounts.autoApplyRepoDefault",
        "claudeAccounts.reloadBehavior",
        "claudeAccounts.onUsageLimit"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%virtual.description%"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p .",
    "l10n": "node scripts/check-l10n.js",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run l10n",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "coverage": "c8 node --test \"test/unit/**/*.test.js\"",
    "test:integration": "vscode-test",
    "package": "vsce package --no-dependencies",
    "docs": "node scripts/settings-docs.js",
    "docs:check": "node scripts/settings-docs.js --check",
    "screenshots": "node scripts/screenshots/run.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "claudeAccounts.switch",
        "title": "%cmd.switch%",
        "category": "%category%",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "claudeAccounts.switchToPrevious",
        "title": "%cmd.switchToPrevious%",
        "category": "%category%"
      },
      {
        "command": "claudeAccounts.add",
        "title": "%cmd.add%",
        "category": "%category%",
        "icon": "$(add)"
      },
      {
        "command": "claudeAccounts.manage",
        "title": "%cmd.manage%",
        "category": "%category%",
        "icon": "$(gear)"
      },
      {
        "command": "claudeAccounts.login",
        "title": "%cmd.login%",
        "category": "%category%",
        "icon": "$(key)"
      },
      {
        "command": "claudeAccounts.openTerminal",
        "title": "%cmd.openTerminal%",
        "category": "%category%",
        "icon": "$(terminal)"
      },
      {
        "command": "claudeAccounts.continueInTerminal",
        "title": "%cmd.continueInTerminal%",
        "category": "%category%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claudeAccounts.rename",
        "title": "%cmd.rename%",
        "category": "%category%",
        "icon": "$(edit)"
      },
      {
        "command": "claudeAccounts.appearance",
        "title": "%cmd.appearance%",
        "category": "%category%",
        "icon": "$(symbol-color)"
      },
      {
        "command": "claudeAccounts.editEnvironment",
        "title": "%cmd.editEnvironment%",
        "category": "%category%",
        "icon": "$(symbol-variable)"
      },
      {
        "command": "claudeAccounts.makeIsolated",
        "title": "%cmd.makeIsolated%",
        "category": "%category%",
        "icon": "$(lock)"
      },
      {
        "command": "claudeAccounts.makeShared",
        "title": "%cmd.makeShared%",
        "category": "%category%",
        "icon": "$(link)"
      },
      {
        "command": "claudeAccounts.relink",
        "title": "%cmd.relink%",
        "category": "%category%",
        "icon": "$(sync)"
      },
      {
        "command": "claudeAccounts.openFolder",
        "title": "%cmd.openFolder%",
        "category": "%category%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "claudeAccounts.remove",
        "title": "%cmd.remove%",
        "category": "%category%",
        "icon": "$(trash)"
      },
      {
        "command": "claudeAccounts.setRepoDefault",
        "title": "%cmd.setRepoDefault%",
        "category": "%category%",
        "icon": "$(pin)"
      },
      {
        "command": "claudeAccounts.clearRepoDefault",
        "title": "%cmd.clearRepoDefault%",
        "category": "%category%",
        "icon": "$(pinned)"
      },
      {
        "command": "claudeAccounts.addRule",
        "title": "%cmd.addRule%",
        "category": "%category%",
        "icon": "$(list-filter)"
      },
      {
        "command": "claudeAccounts.showUsage",
        "title": "%cmd.showUsage%",
        "category": "%category%",
        "icon": "$(graph)"
      },
      {
        "command": "claudeAccounts.toggleHistorySharing",
        "title": "%cmd.toggleHistorySharing%",
        "category": "%category%",
        "icon": "$(history)"
      },
      {
        "command": "claudeAccounts.toggleLiveQuota",
        "title": "%cmd.toggleLiveQuota%",
        "category": "%category%",
        "icon": "$(dashboard)"
      },
      {
        "command": "claudeAccounts.importExisting",
        "title": "%cmd.importExisting%",
        "category": "%category%",
        "icon": "$(folder-library)"
      },
      {
        "command": "claudeAccounts.exportSettings",
        "title": "%cmd.exportSettings%",
        "category": "%category%",
        "icon": "$(export)"
      },
      {
        "command": "claudeAccounts.importSettings",
        "title": "%cmd.importSettings%",
        "category": "%category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "claudeAccounts.diagnose",
        "title": "%cmd.diagnose%",
        "category": "%category%",
        "icon": "$(pulse)"
      },
      {
        "command": "claudeAccounts.reviewIssues",
        "title": "%cmd.reviewIssues%",
        "category": "%category%",
        "icon": "$(warning)"
      },
      {
        "command": "claudeAccounts.showLog",
        "title": "%cmd.showLog%",
        "category": "%category%",
        "icon": "$(output)"
      },
      {
        "command": "claudeAccounts.refresh",
        "title": "%cmd.refresh%",
        "category": "%category%",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "claudeAccounts.setRepoDefault",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "claudeAccounts.clearRepoDefault",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "claudeAccounts.addRule",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "claudeAccounts.refresh",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "claudeAccounts.add",
          "when": "view == claudeAccounts.accounts",
          "group": "navigation@1"
        },
        {
          "command": "claudeAccounts.showUsage",
          "when": "view == claudeAccounts.accounts",
          "group": "navigation@2"
        },
        {
          "command": "claudeAccounts.refresh",
          "when": "view == claudeAccounts.accounts",
          "group": "navigation@3"
        },
        {
          "command": "claudeAccounts.toggleHistorySharing",
          "when": "view == claudeAccounts.accounts",
          "group": "1_sharing@1"
        },
        {
          "command": "claudeAccounts.toggleLiveQuota",
          "when": "view == claudeAccounts.accounts",
          "group": "1_sharing@2"
        },
        {
          "command": "claudeAccounts.addRule",
          "when": "view == claudeAccounts.accounts && workspaceFolderCount > 0",
          "group": "2_repo@1"
        },
        {
          "command": "claudeAccounts.exportSettings",
          "when": "view == claudeAccounts.accounts",
          "group": "3_transfer@1"
        },
        {
          "command": "claudeAccounts.importSettings",
          "when": "view == claudeAccounts.accounts",
          "group": "3_transfer@2"
        },
        {
          "command": "claudeAccounts.importExisting",
          "when": "view == claudeAccounts.accounts",
          "group": "3_transfer@3"
        },
        {
          "command": "claudeAccounts.diagnose",
          "when": "view == claudeAccounts.accounts",
          "group": "4_help@1"
        },
        {
          "command": "claudeAccounts.showLog",
          "when": "view == claudeAccounts.accounts",
          "group": "4_help@2"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeAccounts.switch",
          "when": "view == claudeAccounts.accounts && viewItem =~ /\\.other\\b/",
          "group": "inline@1"
        },
        {
          "command": "claudeAccounts.login",
          "when": "view == claudeAccounts.accounts && viewItem =~ /\\.login\\b/",
          "group": "inline@2"
        },
        {
          "command": "claudeAccounts.openTerminal",
          "when": "view == claudeAccounts.accounts && viewItem =~ /^account/",
          "group": "inline@3"
        },
        {
          "command": "claudeAccounts.switch",
          "when": "view == claudeAccounts.accounts && viewItem =~ /\\.other\\b/",
          "group": "1_use@1"
        },
        {
          "command": "claudeAccounts.login",
          "when": "view == claudeAccounts.accounts && viewItem =~ /\\.login\\b/",
          "group": "1_use@2"
        },
        {
          "command": "claudeAccounts.openTerminal",
          "when": "view == claudeAccounts.accounts && viewItem =~ /^account/",
          "group": "1_use@3"
        },
        {
          "command": "claudeAccounts.continueInTerminal",
          "when": "view == claudeAccounts.accounts && viewItem =~ /^account/ && config.claudeAccounts.shareHistory",
          "group": "1_use@4"
        },
        {
          "command": "claudeAccounts.setRepoDefault",
          "when": "view == claudeAccounts.accounts && viewItem =~ /^account/ && workspaceFolderCount > 0",
          "group": "1_use@5"
        },
        {
          "command": "claudeAccounts.rename",
          "when": "view == claudeAccounts.accounts && viewItem =~ /^account/",
          "group": "2_edit@1"
        },
        {
          "command": "claudeAccounts.appearance",
          "when": "view == claudeAccounts.accounts && viewItem =~ /^account/",
          "group": "2_edit@2"
        },
        {
          "command": "claudeAccounts.editEnvironment",
          "when": "view == claudeAccounts.accounts && viewItem =~ /^account/",
          "group": "2_edit@3"
        },
        {
          "command": "claudeAccounts.makeIsolated",
          "when": "view == claudeAccounts.accounts && viewItem =~ /\\.shared\\b/",
          "group": "3_profile@1"
        },
        {
          "command": "claudeAccounts.makeShared",
          "when": "view == claudeAccounts.accounts && viewItem =~ /\\.isolated\\b/",
          "group": "3_profile@1"
        },
        {
          "command": "claudeAccounts.relink",
          "when": "view == claudeAccounts.accounts && viewItem =~ /\\.(shared|isolated)\\b/",
          "group": "3_profile@2"
        },
        {
          "command": "claudeAccounts.openFolder",
          "when": "view == claudeAccounts.accounts && viewItem =~ /^account/",
          "group": "3_profile@3"
        },
        {
          "command": "claudeAccounts.remove",
          "when": "view == claudeAccounts.accounts && viewItem =~ /\\.(shared|isolated)\\b/",
          "group": "9_remove@1"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "claudeAccounts.accounts",
          "name": "%view.accounts%",
          "visibility": "collapsed",
          "contextualTitle": "%displayName%"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "claudeAccounts.start",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "add",
            "title": "%walkthrough.add.title%",
            "description": "%walkthrough.add.description%",
            "media": {
              "markdown": "media/walkthrough/add.md"
            },
            "completionEvents": [
              "onCommand:claudeAccounts.add"
            ]
          },
          {
            "id": "login",
            "title": "%walkthrough.login.title%",
            "description": "%walkthrough.login.description%",
            "media": {
              "markdown": "media/walkthrough/login.md"
            },
            "completionEvents": [
              "onCommand:claudeAccounts.login"
            ]
          },
          {
            "id": "switch",
            "title": "%walkthrough.switch.title%",
            "description": "%walkthrough.switch.description%",
            "media": {
              "markdown": "media/walkthrough/switch.md"
            },
            "completionEvents": [
              "onCommand:claudeAccounts.switch"
            ]
          },
          {
            "id": "defaults",
            "title": "%walkthrough.defaults.title%",
            "description": "%walkthrough.defaults.description%",
            "media": {
              "markdown": "media/walkthrough/defaults.md"
            },
            "completionEvents": [
              "onCommand:claudeAccounts.setRepoDefault",
              "onCommand:claudeAccounts.addRule"
            ]
          },
          {
            "id": "limits",
            "title": "%walkthrough.limits.title%",
            "description": "%walkthrough.limits.description%",
            "media": {
              "markdown": "media/walkthrough/limits.md"
            },
            "completionEvents": [
              "onCommand:claudeAccounts.toggleLiveQuota",
              "onCommand:claudeAccounts.toggleHistorySharing"
            ]
          },
          {
            "id": "diagnose",
            "title": "%walkthrough.diagnose.title%",
            "description": "%walkthrough.diagnose.description%",
            "media": {
              "markdown": "media/walkthrough/diagnose.md"
            },
            "completionEvents": [
              "onCommand:claudeAccounts.diagnose"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "%displayName%",
      "properties": {
        "claudeAccounts.scope": {
          "order": 1,
          "scope": "application",
          "type": "string",
          "enum": [
            "workspace",
            "user"
          ],
          "enumDescriptions": [
            "%cfg.scope.workspace%",
            "%cfg.scope.user%"
          ],
          "default": "workspace",
          "description": "%cfg.scope%"
        },
        "claudeAccounts.reloadBehavior": {
          "order": 2,
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "%cfg.reloadBehavior.ask%",
            "%cfg.reloadBehavior.always%",
            "%cfg.reloadBehavior.never%"
          ],
          "default": "ask",
          "description": "%cfg.reloadBehavior%"
        },
        "claudeAccounts.autoApplyRepoDefault": {
          "order": 3,
          "type": "boolean",
          "default": true,
          "description": "%cfg.autoApplyRepoDefault%"
        },
        "claudeAccounts.rules": {
          "order": 4,
          "scope": "application",
          "type": "array",
          "default": [],
          "markdownDescription": "%cfg.rules%",
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "account"
            ],
            "additionalProperties": false,
            "properties": {
              "pattern": {
                "type": "string",
                "minLength": 1,
                "description": "%cfg.rules.pattern%"
              },
              "account": {
                "type": "string",
                "minLength": 1,
                "description": "%cfg.rules.account%"
              }
            }
          }
        },
        "claudeAccounts.statusBarStyle": {
          "order": 10,
          "type": "string",
          "enum": [
            "name",
            "initials",
            "icon"
          ],
          "enumDescriptions": [
            "%cfg.statusBarStyle.name%",
            "%cfg.statusBarStyle.initials%",
            "%cfg.statusBarStyle.icon%"
          ],
          "default": "name",
          "description": "%cfg.statusBarStyle%"
        },
        "claudeAccounts.showPlan": {
          "order": 11,
          "type": "boolean",
          "default": true,
          "description": "%cfg.showPlan%"
        },
        "claudeAccounts.showQuota": {
          "order": 12,
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.showQuota%"
        },
        "claudeAccounts.onUsageLimit": {
          "order": 20,
          "type": "string",
          "enum": [
            "suggest",
            "switch",
            "ignore"
          ],
          "enumDescriptions": [
            "%cfg.onUsageLimit.suggest%",
            "%cfg.onUsageLimit.switch%",
            "%cfg.onUsageLimit.ignore%"
          ],
          "default": "suggest",
          "description": "%cfg.onUsageLimit%"
        },
        "claudeAccounts.liveQuota": {
          "order": 21,
          "scope": "application",
          "type": "boolean",
          "default": false,
          "markdownDescription": "%cfg.liveQuota%"
        },
        "claudeAccounts.quotaThreshold": {
          "order": 22,
          "scope": "application",
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 95,
          "markdownDescription": "%cfg.quotaThreshold%"
        },
        "claudeAccounts.shareHistory": {
          "order": 30,
          "scope": "application",
          "type": "boolean",
          "default": false,
          "markdownDescription": "%cfg.shareHistory%"
        },
        "claudeAccounts.historyItems": {
          "order": 31,
          "scope": "application",
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [
            "projects",
            "history.jsonl",
            "file-history",
            "todos",
            "plans"
          ],
          "description": "%cfg.historyItems%"
        },
        "claudeAccounts.sharedItemsMode": {
          "order": 32,
          "scope": "application",
          "type": "string",
          "enum": [
            "list",
            "allExcept"
          ],
          "enumDescriptions": [
            "%cfg.sharedItemsMode.list%",
            "%cfg.sharedItemsMode.allExcept%"
          ],
          "default": "list",
          "description": "%cfg.sharedItemsMode%"
        },
        "claudeAccounts.sharedItems": {
          "order": 33,
          "scope": "application",
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [
            "settings.json",
            "CLAUDE.md",
            "agents",
            "commands",
            "skills",
            "hooks",
            "output-styles",
            "plugins",
            "rules",
            "workflows",
            "keybindings.json",
            "themes"
          ],
          "markdownDescription": "%cfg.sharedItems%"
        },
        "claudeAccounts.sharedItemsExclude": {
          "order": 34,
          "scope": "application",
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [],
          "markdownDescription": "%cfg.sharedItemsExclude%"
        },
        "claudeAccounts.shareMcpServers": {
          "order": 35,
          "scope": "application",
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.shareMcpServers%"
        },
        "claudeAccounts.applyToTerminal": {
          "order": 40,
          "type": "boolean",
          "default": true,
          "description": "%cfg.applyToTerminal%"
        },
        "claudeAccounts.loginCommand": {
          "order": 41,
          "scope": "application",
          "type": "string",
          "default": "claude auth login",
          "description": "%cfg.loginCommand%"
        },
        "claudeAccounts.accountsRoot": {
          "order": 42,
          "scope": "application",
          "type": "string",
          "default": "",
          "description": "%cfg.accountsRoot%"
        },
        "claudeAccounts.gravatar": {
          "order": 50,
          "scope": "application",
          "type": "boolean",
          "default": false,
          "description": "%cfg.gravatar%"
        },
        "claudeAccounts.suggestSwitchOnLimit": {
          "order": 99,
          "type": "boolean",
          "default": true,
          "description": "%cfg.suggestSwitchOnLimit%",
          "markdownDeprecationMessage": "%cfg.suggestSwitchOnLimit.deprecated%"
        }
      }
    },
    "keybindings": [
      {
        "command": "claudeAccounts.switchToPrevious",
        "key": "ctrl+alt+shift+a",
        "mac": "cmd+alt+shift+a"
      }
    ],
    "colors": [
      {
        "id": "claudeAccounts.orange",
        "description": "%color.orange%",
        "defaults": {
          "dark": "#E8915B",
          "light": "#C2621F",
          "highContrast": "#E8915B",
          "highContrastLight": "#C2621F"
        }
      },
      {
        "id": "claudeAccounts.green",
        "description": "%color.green%",
        "defaults": {
          "dark": "#7BC67E",
          "light": "#2E8B3A",
          "highContrast": "#7BC67E",
          "highContrastLight": "#2E8B3A"
        }
      },
      {
        "id": "claudeAccounts.blue",
        "description": "%color.blue%",
        "defaults": {
          "dark": "#6CA8F0",
          "light": "#1F64C2",
          "highContrast": "#6CA8F0",
          "highContrastLight": "#1F64C2"
        }
      },
      {
        "id": "claudeAccounts.purple",
        "description": "%color.purple%",
        "defaults": {
          "dark": "#B48EF0",
          "light": "#7A3FD1",
          "highContrast": "#B48EF0",
          "highContrastLight": "#7A3FD1"
        }
      },
      {
        "id": "claudeAccounts.pink",
        "description": "%color.pink%",
        "defaults": {
          "dark": "#F08DC0",
          "light": "#C2337E",
          "highContrast": "#F08DC0",
          "highContrastLight": "#C2337E"
        }
      },
      {
        "id": "claudeAccounts.yellow",
        "description": "%color.yellow%",
        "defaults": {
          "dark": "#E6C84F",
          "light": "#9A7B00",
          "highContrast": "#E6C84F",
          "highContrastLight": "#9A7B00"
        }
      },
      {
        "id": "claudeAccounts.teal",
        "description": "%color.teal%",
        "defaults": {
          "dark": "#5BC2B4",
          "light": "#16806F",
          "highContrast": "#5BC2B4",
          "highContrastLight": "#16806F"
        }
      },
      {
        "id": "claudeAccounts.red",
        "description": "%color.red%",
